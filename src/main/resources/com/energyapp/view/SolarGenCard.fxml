<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox id="solarGenCardRoot" maxHeight="-Infinity" maxWidth="-Infinity" spacing="8.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.SolarStatusCardController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <Label id="solarGenCardTitle" text="Solar Array Status" />
      <Label fx:id="solarStatusLabel" id="solarStatusValueLabel" text="Status: Pending" />
      <Label fx:id="solarGenerationLabel" id="solarGenerationValueLabel" text="Generation: 0/Max" />
      <ProgressBar fx:id="generationProgressBar" id="solarGenerationProgressBar" maxWidth="1.7976931348623157E308" prefWidth="200.0" progress="0.0" />
      <Button fx:id="simulateFaultButton" id="solarSimulateFaultButton" mnemonicParsing="false" text="Simulate Fault" />
   </children>
</VBox>