<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="smartPlugSettingsRoot" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="640.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.SmartPlugSettingsController">
   <children>
      <Label fx:id="deviceNameTitle" id="smartPlugSettingsTitle" text="Plug Name" />
      <HBox id="smartPlugPowerRow">
         <children>
            <Label id="smartPlugPowerLabel" text="Power:" />
            <ToggleButton fx:id="powerToggle" id="smartPlugPowerToggle" mnemonicParsing="false" text="ON" />
         </children>
      </HBox>
      <HBox id="smartPlugCutoffRow">
         <children>
            <Label id="smartPlugCutoffLabel" text="Price Cut-off (pence per kWh):" />
            <TextField fx:id="cutoffInput" id="smartPlugCutoffInput" />
         </children>
      </HBox>
      <Button fx:id="applyButton" id="smartPlugApplyButton" mnemonicParsing="false" text="Apply" />
   </children>
</VBox>