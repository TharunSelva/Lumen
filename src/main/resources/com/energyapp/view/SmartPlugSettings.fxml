<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxWidth="-Infinity" minWidth="-Infinity" prefWidth="640.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.SmartPlugSettingsController">
   <children>
      <Label fx:id="deviceNameTitle" text="Plug Name">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>
      <HBox>
         <children>
            <Label text="Power:">
               <font>
                  <Font size="19.0" />
               </font>
            </Label>
            <ToggleButton fx:id="powerToggle" mnemonicParsing="false" text="ON" />
         </children>
      </HBox>
      <HBox>
         <children>
            <Label text="Price Cut-off (pence per kWh):">
               <font>
                  <Font size="19.0" />
               </font>
            </Label>
            <TextField fx:id="cutoffInput" />
         </children>
      </HBox>
   </children>
</VBox>
