<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox minHeight="-Infinity" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.SetupModalController">
   <children>
      <Label text="Welcome!">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <HBox>
         <children>
            <Label text="Enter location:" />
            <Region prefWidth="10.0" />
            <TextField fx:id="cityTextField" text="City goes here..." />
         </children>
      </HBox>
      <HBox>
         <children>
            <Button fx:id="saveButton" mnemonicParsing="false" text="Save" />
            <Region prefWidth="30.0" />
            <Label fx:id="errorLabel" alignment="TOP_RIGHT" textAlignment="RIGHT" />
         </children>
      </HBox>
   </children>
</VBox>
