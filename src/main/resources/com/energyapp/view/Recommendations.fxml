<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800" prefWidth="1200" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.RecommendationsController" id="recommendations-auto-1">
   <ScrollPane prefHeight="200.0" prefWidth="200.0">
      <content>
      
          <BorderPane prefHeight="800" prefWidth="1200" id="recommendations-auto-2">
      
              <!-- CENTER CONTENT -->
              <center>
                  <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" id="recommendations-auto-3">
      
                      <content>
                          <VBox spacing="14" id="recommendations-auto-4">
                              <padding>
                                  <Insets bottom="16" left="16" right="16" top="16" />
                              </padding>
      
                              <!-- Header row (same vibe as your friend's header row) -->
                              <HBox alignment="CENTER_LEFT" spacing="12">
                                  <VBox spacing="4" HBox.hgrow="ALWAYS">
                                      <Label text="Curated Recommendations for you"  id="recommendations-auto-5"/>
                                      <Label text="We can help."  id="recommendations-auto-6"/>
                                  </VBox>
      
                                  <!-- Optional little icon button like his settings button -->
                                  <Button mnemonicParsing="false" id="recommendations-auto-7">
                                      <graphic>
                                          <Label text="✨"  id="recommendations-auto-8"/>
                                      </graphic>
                                  </Button>
                              </HBox>
      
                              <!-- Row 1: Left priority card + right lists -->
                              <HBox spacing="16">
      
                                  <!-- Priority card -->
                                  <VBox spacing="10" HBox.hgrow="ALWAYS" id="recommendations-auto-9">
                                      <padding>
                                          <Insets bottom="14" left="16" right="16" top="14" />
                                      </padding>
      
                                      <Label text="⚡ Priority Recommendations"  id="recommendations-auto-10"/>
      
                                      <Label text="Charge your EV between 02:30–04:00 tonight" wrapText="true" />
      
                                      <Label text="Why: lowest tariff + low carbon intensity" wrapText="true"  id="recommendations-auto-11"/>
      
                                      <Label text="Impact: saves ~£0.70 and 0.4 kg CO₂" wrapText="true"  id="recommendations-auto-12"/>
      
                                      <Button maxWidth="170" mnemonicParsing="false" text="Schedule charging"  id="recommendations-auto-13"/>
                                  </VBox>
      
                                  <!-- Right lists column -->
                                  <VBox spacing="14" HBox.hgrow="ALWAYS">
      
                                      <VBox spacing="8" id="recommendations-auto-14">
                                          <padding>
                                              <Insets bottom="14" left="16" right="16" top="14" />
                                          </padding>
      
                                          <Label text="Smart Savings for Tonight"  id="recommendations-auto-15"/>
                                          <Label text="☾  Shift dishwasher" />
                                          <Label text="🔋  Allow battery discharge" />
                                      </VBox>
      
                                      <VBox spacing="8" id="recommendations-auto-16">
                                          <padding>
                                              <Insets bottom="14" left="16" right="16" top="14" />
                                          </padding>
      
                                          <Label text="Solar Opportunities Tomorrow"  id="recommendations-auto-17"/>
                                          <Label text="☀  Heat water cylinder" />
                                          <Label text="🔌  Top up EV" />
                                      </VBox>
      
                                  </VBox>
                              </HBox>
      
                              <Region prefHeight="6" />
                        <VBox fx:id="recommendationsContainer" spacing="10"/>
                          </VBox>
                      </content>
                  </ScrollPane>
              </center>
          </BorderPane>
      </content>
   </ScrollPane>
</StackPane>
