<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="addDeviceFormRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      alignment="TOP_LEFT" spacing="14.0"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.energyapp.controller.AddDeviceController">
   <padding>
      <Insets top="18.0" right="18.0" bottom="18.0" left="18.0" />
   </padding>
   <children>
      <Label id="addDeviceFormTitle" text="Add Device" />
      <HBox id="addDeviceNameRow" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label id="addDeviceNameLabel" prefWidth="110.0" text="Device Name:" />
            <TextField fx:id="deviceName" id="addDeviceNameField" prefWidth="220.0" />
         </children>
      </HBox>
      <HBox id="addDeviceTypeRow" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label id="addDeviceTypeLabel" prefWidth="110.0" text="Device Type:" />
            <ComboBox fx:id="selectDeviceType" id="addDeviceTypeCombo" prefWidth="220.0" />
         </children>
      </HBox>
      <HBox id="addDeviceButtonRow" alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="addButton" id="addDeviceConfirmButton" mnemonicParsing="false" text="Add" />
            <Button fx:id="cancelButton" id="addDeviceCancelButton" mnemonicParsing="false" text="Cancel" />
         </children>
      </HBox>
   </children>
</VBox>