<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="addDeviceFormRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.AddDeviceController">
   <children>
      <Label id="addDeviceFormTitle" text="Add Device" />
      <HBox id="addDeviceNameRow">
         <children>
            <Label id="addDeviceNameLabel" text="Device Name:" />
            <TextField fx:id="deviceName" id="addDeviceNameField" />
         </children>
      </HBox>
      <HBox id="addDeviceTypeRow">
         <children>
            <Label id="addDeviceTypeLabel" text="Device Type:" />
            <ComboBox fx:id="selectDeviceType" id="addDeviceTypeCombo" prefWidth="150.0" />
         </children>
      </HBox>
      <HBox />
      <HBox id="addDeviceButtonRow">
         <children>
            <Button fx:id="addButton" id="addDeviceConfirmButton" mnemonicParsing="false" text="Add" />
            <Button fx:id="cancelButton" id="addDeviceCancelButton" mnemonicParsing="false" text="Cancel" />
         </children>
      </HBox>
   </children>
</VBox>