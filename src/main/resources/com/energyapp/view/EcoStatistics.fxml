<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="800" prefWidth="1200" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.EcoStatisticsController" id="ecostatistics-auto-1">
    <ScrollPane prefHeight="200.0" prefWidth="200.0" fitToWidth="true" fitToHeight="true">
        <content>

            <BorderPane prefHeight="800" prefWidth="1200" id="ecostatistics-auto-2">
                <center>
                    <VBox maxWidth="Infinity" spacing="12" id="ecostatistics-auto-3">
                        <padding>
                            <Insets bottom="14" left="14" right="14" top="14" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" maxHeight="64" prefHeight="64" spacing="12">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Eco Statistics"  id="ecostatistics-auto-4"/>
                                <Label text="Today • Updated 1 hr ago"  id="ecostatistics-auto-5"/>
                            </VBox>
      
                          <ComboBox prefWidth="90" promptText="Day" />
      
                          <Button mnemonicParsing="false" id="ecostatistics-auto-6">
                              <graphic>
                                  <Label text="⚙"  id="ecostatistics-auto-7"/>
                              </graphic>
                          </Button>
                      </HBox>
      
                      <!-- TOP ROW (fixed smaller height) -->
                      <GridPane hgap="16" maxHeight="160" maxWidth="Infinity" prefHeight="160" vgap="0">
                          <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                          </columnConstraints>
      
                          <!-- KPIs -->
                          <VBox maxWidth="Infinity" spacing="10" GridPane.columnIndex="0" id="ecostatistics-auto-8">
                              <padding>
                           <Insets bottom="12" left="14" right="14" top="12" />
                        </padding>
      
                              <HBox spacing="10">
                                  <VBox spacing="2" HBox.hgrow="ALWAYS" id="ecostatistics-auto-9">
                                      <padding>
                                 <Insets bottom="8" left="10" right="10" top="8" />
                              </padding>
                                      <Label text="211 gCO₂/kWh"  id="ecostatistics-auto-10"/>
                                      <Label text="UK average right now"  id="ecostatistics-auto-11"/>
                                  </VBox>
      
                                  <VBox spacing="2" HBox.hgrow="ALWAYS" id="ecostatistics-auto-12">
                                      <padding>
                                 <Insets bottom="8" left="10" right="10" top="8" />
                              </padding>
                                      <Label text="150 gCO₂/kWh"  id="ecostatistics-auto-13"/>
                                      <Label text="Your Carbon Footprint"  id="ecostatistics-auto-14"/>
                                  </VBox>
                              </HBox>
      
                              <VBox spacing="2" id="ecostatistics-auto-15">
                                  <padding>
                              <Insets bottom="8" left="10" right="10" top="8" />
                           </padding>
                                  <Label text="Your Eco Score:"  id="ecostatistics-auto-16"/>
                                  <HBox alignment="BASELINE_LEFT" spacing="6">
                                      <Label text="72"  id="ecostatistics-auto-17"/>
                                      <Label text="/ 100"  id="ecostatistics-auto-18"/>
                                  </HBox>
                                  <Label text="Better than yesterday (+8)"  id="ecostatistics-auto-19"/>
                              </VBox>
                          </VBox>
      
                          <!-- Clean Energy Share -->
                          <VBox maxWidth="Infinity" spacing="8" GridPane.columnIndex="1" id="ecostatistics-auto-20">
                              <padding>
                           <Insets bottom="12" left="14" right="14" top="12" />
                        </padding>

                              <Label fx:id="cleanEnergyShareLabel" text="Clean Energy Share: 0%"  id="cleanEnergyShareLabel"/>

                              <StackPane fx:id="cleanEnergyChartContainer" maxHeight="150" maxWidth="Infinity" prefHeight="150"  id="cleanEnergyChartContainer"/>
      
                              <GridPane hgap="10" vgap="6">
                                  <columnConstraints>
                                      <ColumnConstraints percentWidth="50" />
                                      <ColumnConstraints percentWidth="50" />
                                  </columnConstraints>
      
                                  <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                      <Rectangle arcHeight="3" arcWidth="3" height="9" width="9"  id="ecostatistics-auto-21"/>
                                      <Label text="Solar (38%)"  id="ecostatistics-auto-22"/>
                                  </HBox>
                                  <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                      <Rectangle arcHeight="3" arcWidth="3" height="9" width="9"  id="ecostatistics-auto-23"/>
                                      <Label text="Low-carbon grid"  id="ecostatistics-auto-24"/>
                                  </HBox>
                                  <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                      <Rectangle arcHeight="3" arcWidth="3" height="9" width="9"  id="ecostatistics-auto-25"/>
                                      <Label text="Battery (16%)"  id="ecostatistics-auto-26"/>
                                  </HBox>
                                  <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                      <Rectangle arcHeight="3" arcWidth="3" height="9" width="9"  id="ecostatistics-auto-27"/>
                                      <Label text="Fossil grid (54%)"  id="ecostatistics-auto-28"/>
                                  </HBox>
                           <rowConstraints>
                              <RowConstraints />
                              <RowConstraints />
                           </rowConstraints>
                              </GridPane>
                          </VBox>
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                      </GridPane>
      
                      <!-- MIDDLE ROW (fixed height so bottom stays visible) -->
                      <GridPane hgap="16" maxHeight="250" maxWidth="Infinity" prefHeight="250" vgap="0">
                          <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                          </columnConstraints>
      
                          <!-- Eco Timeline (compressed) -->
                          <VBox spacing="8" GridPane.columnIndex="0" id="ecostatistics-auto-29">
                              <padding>
                           <Insets bottom="12" left="14" right="14" top="12" />
                        </padding>
      
                              <Label text="Eco Timeline"  id="ecostatistics-auto-30"/>
      
                              <VBox spacing="10" id="ecostatistics-auto-31">
                                  <padding>
                              <Insets bottom="10" left="10" right="10" top="10" />
                           </padding>
      
                                  <!-- smaller blocks -->
                                  <HBox spacing="6">
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-32">
                                          <Label text="H"  id="ecostatistics-auto-33"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-34">
                                          <Label text="H"  id="ecostatistics-auto-35"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-36">
                                          <Label text="M"  id="ecostatistics-auto-37"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-38">
                                          <Label text="M"  id="ecostatistics-auto-39"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-40">
                                          <Label text="L"  id="ecostatistics-auto-41"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-42">
                                          <Label text="L"  id="ecostatistics-auto-43"/>
                                      </StackPane>
                                  </HBox>
      
                                  <HBox spacing="6">
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-44">
                                          <Label text="L"  id="ecostatistics-auto-45"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-46">
                                          <Label text="L"  id="ecostatistics-auto-47"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-48">
                                          <Label text="M"  id="ecostatistics-auto-49"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-50">
                                          <Label text="H"  id="ecostatistics-auto-51"/>
                                      </StackPane>
                                      <StackPane prefHeight="34" prefWidth="26" id="ecostatistics-auto-52">
                                          <Label text="H"  id="ecostatistics-auto-53"/>
                                      </StackPane>
                                  </HBox>
      
                                  <!-- smaller callout -->
                                  <VBox spacing="2" id="ecostatistics-auto-54">
                                      <padding>
                                 <Insets bottom="8" left="10" right="10" top="8" />
                              </padding>
                                      <Label text="13:00 — Low carbon hour"  id="ecostatistics-auto-55"/>
                                      <Label text="Grid intensity: 142 gCO₂/kWh"  id="ecostatistics-auto-56"/>
                                      <Label text="Solar contributed 82% of household use"  id="ecostatistics-auto-57"/>
                                      <Label text="Good time for flexible tasks"  id="ecostatistics-auto-58"/>
                                  </VBox>
                              </VBox>
                          </VBox>
      
                          <!-- History Graph (compressed height) -->
                          <VBox spacing="8" GridPane.columnIndex="1" id="ecostatistics-auto-59">
                              <padding>
                           <Insets bottom="12" left="14" right="14" top="12" />
                        </padding>
      
                              <Label text="Eco-Impact History"  id="ecostatistics-auto-60"/>
      
                              <StackPane VBox.vgrow="ALWAYS" id="ecostatistics-auto-61">
                                  <Label text="[Graph showing how eco-impact has changed]"  id="ecostatistics-auto-62"/>
                              </StackPane>
                          </VBox>
                     <rowConstraints>
                        <RowConstraints />
                     </rowConstraints>
                      </GridPane>
      
                      <!-- BOTTOM ROW (fixed height) -->
                      <VBox maxHeight="270" maxWidth="Infinity" prefHeight="270" spacing="10" id="ecostatistics-auto-63">
                          <padding>
                        <Insets bottom="12" left="14" right="14" top="12" />
                     </padding>
      
                          <Label text="Environmental Breakdown"  id="ecostatistics-auto-64"/>
      
                          <GridPane hgap="16" maxWidth="Infinity" vgap="0" VBox.vgrow="ALWAYS">
                              <columnConstraints>
                                  <ColumnConstraints hgrow="ALWAYS" percentWidth="64" />
                                  <ColumnConstraints hgrow="ALWAYS" percentWidth="36" />
                              </columnConstraints>
      
                              <!-- Energy Source (short chart) -->
                              <VBox spacing="8" GridPane.columnIndex="0" id="ecostatistics-auto-65">
                                  <padding>
                              <Insets bottom="10" left="10" right="10" top="10" />
                           </padding>
      
                                  <Label text="By Energy Source"  id="ecostatistics-auto-66"/>

                                  <BarChart fx:id="environmentalBreakdownChart" animated="false" legendVisible="true" maxHeight="120" prefHeight="120" title="">
                                      <xAxis>
                                 <CategoryAxis label="" />
                              </xAxis>
                                      <yAxis>
                                 <NumberAxis label="" />
                              </yAxis>
                                  </BarChart>
      
                                  <HBox>
                                      <Label text="Total"  id="ecostatistics-auto-67"/>
                                      <Region HBox.hgrow="ALWAYS" />
                                      <Label text="3.1 kg CO₂"  id="ecostatistics-auto-68"/>
                                  </HBox>
                              </VBox>
      
                              <!-- Device Category (tighter text) -->
                              <VBox spacing="8" GridPane.columnIndex="1" id="ecostatistics-auto-69">
                                  <padding>
                              <Insets bottom="10" left="10" right="10" top="10" />
                           </padding>
      
                                  <Label text="By Device Category"  id="ecostatistics-auto-70"/>
      
                                  <VBox spacing="8">
                                      <HBox>
                                 <Label text="🚗  EV"  id="ecostatistics-auto-71"/>
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label text="3.1 kg CO₂"  id="ecostatistics-auto-72"/>
                              </HBox>
                                      <HBox>
                                 <Label text="♨  Heating"  id="ecostatistics-auto-73"/>
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label text="10.8 kg CO₂"  id="ecostatistics-auto-74"/>
                              </HBox>
                                      <HBox>
                                 <Label text="🧺  Laundry"  id="ecostatistics-auto-75"/>
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label text="4.7 kg CO₂"  id="ecostatistics-auto-76"/>
                              </HBox>
                                      <HBox>
                                 <Label text="🍳  Kitchen"  id="ecostatistics-auto-77"/>
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label text="1.2 kg CO₂"  id="ecostatistics-auto-78"/>
                              </HBox>
                                      <HBox>
                                 <Label text="⏻  Standby"  id="ecostatistics-auto-79"/>
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label text="0.0 kg CO₂"  id="ecostatistics-auto-80"/>
                              </HBox>
                                  </VBox>
                              </VBox>
                        <rowConstraints>
                           <RowConstraints />
                        </rowConstraints>
                          </GridPane>
                      </VBox>
      
                  </VBox>
              </center>
          </BorderPane>
      </content>
   </ScrollPane>
</StackPane>
