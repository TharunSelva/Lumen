<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane id="energystatistics-auto-1" prefHeight="800.0" prefWidth="1200.0" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.EnergyStatsController">
    <BorderPane id="energystatistics-auto-2" prefHeight="800.0" prefWidth="1200.0">
        <center>
            <ScrollPane id="energystatistics-auto-3" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox id="energystatistics-auto-4" spacing="14.0" styleClass="energy-stats-page">
                        <padding>
                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label id="energystatistics-auto-5" text="Your energy statistics..." />
                        </HBox>

                        <HBox id="energystatistics-auto-9" spacing="24.0" styleClass="summary-card">
                            <padding>
                                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                            </padding>

                            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="summary-card-title" text="Summary" />
                                <VBox spacing="4.0" styleClass="summary-metric-group">
                                    <Label fx:id="summaryTotalEnergyLabel" styleClass="summary-metric-value" text="0.0 kWh Total Energy" />
                                    <Label styleClass="summary-metric-caption" text="Total household consumption" />
                                </VBox>
                                <VBox spacing="4.0" styleClass="summary-metric-group">
                                    <Label fx:id="summarySolarTodayLabel" styleClass="summary-metric-value" text="0.0 kWh Solar Today" />
                                    <Label styleClass="summary-metric-caption" text="Solar generation captured today" />
                                </VBox>
                            </VBox>

                            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="summary-column-spacer" text="" />
                                <VBox spacing="4.0" styleClass="summary-metric-group">
                                    <Label fx:id="summaryTotalCostLabel" styleClass="summary-metric-value" text="0.00 Total Cost" />
                                    <Label styleClass="summary-metric-caption" text="Based on your time-of-use tariff" />
                                </VBox>
                                <VBox spacing="4.0" styleClass="summary-metric-group">
                                    <Label fx:id="summaryEstimatedContributionLabel" styleClass="summary-metric-value" text="0% solar &#8226; 0% battery &#8226; 0% grid" />
                                    <Label styleClass="summary-metric-caption" text="Estimated source contribution" />
                                </VBox>
                            </VBox>
                        </HBox>

                        <VBox id="energystatistics-auto-18" minHeight="430.0" prefHeight="430.0" spacing="10.0" styleClass="stats-card">
                            <padding>
                                <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                            </padding>

                            <Label id="energystatistics-auto-19" text="Usage" />
                            <Label id="energystatistics-auto-20" text="Hour-by-Hour Usage" />
                            <Label id="energystatistics-auto-21" text="Tip: Click the graph to expand. Use Time Range for rolling 1 hour, 8 hour, daily, weekly, monthly, or all-time views." />

                            <LineChart id="usageChartSmall" fx:id="usageChartSmall" animated="false" createSymbols="true" legendVisible="false" maxHeight="360.0" minHeight="330.0" prefHeight="345.0">
                                <xAxis>
                                    <NumberAxis fx:id="usageSmallXAxis" autoRanging="false" label="" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="usageSmallYAxis" autoRanging="true" label="Power (kWh)" />
                                </yAxis>
                            </LineChart>
                        </VBox>

                        <GridPane hgap="16.0" vgap="16.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="44.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="24.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="32.0" />
                            </columnConstraints>

                            <VBox id="energystatistics-auto-22" spacing="10.0" styleClass="stats-card" GridPane.columnIndex="0">
                                <padding>
                                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                </padding>

                                <Label id="energystatistics-auto-23" text="Costs" />

                                <BarChart fx:id="costsChart" animated="false" legendVisible="false" maxHeight="260.0" prefHeight="245.0" title="">
                                    <xAxis>
                                        <CategoryAxis fx:id="costsXAxis" label="" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="costsYAxis" label="" />
                                    </yAxis>
                                </BarChart>

                                <VBox id="energystatistics-auto-24" spacing="6.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                    <HBox>
                                        <Label text="Total Cost Today:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label id="energystatistics-auto-25" fx:id="totalCostTodayLabel" text="0.00" />
                                    </HBox>
                                    <HBox>
                                        <Label text="Projected daily cost:" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label id="energystatistics-auto-26" fx:id="projectedDailyCostLabel" text="0.00" />
                                    </HBox>
                                </VBox>
                            </VBox>

                            <VBox id="energystatistics-auto-27" prefHeight="595.0" prefWidth="189.0" spacing="10.0" styleClass="stats-card" GridPane.columnIndex="1">
                                <padding>
                                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                </padding>

                                <Label id="energystatistics-auto-28" text="Device-level breakdown" />

                                <VBox fx:id="devicebreakdownpanel" spacing="10.0">
                                    <VBox id="device1" fx:id="device1" spacing="4.0">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                        </padding>
                                        <Label id="device1holder" fx:id="device1holder" text="EV Charger" />
                                        <Label fx:id="device1useage" text="0.0 kWh this week" />
                                        <Label id="weeklycost1" fx:id="weeklycost1" text="Weekly Cost: 0.00" />
                                    </VBox>

                                    <VBox id="device2" fx:id="device2" spacing="4.0">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                        </padding>
                                        <Label id="device2holder" fx:id="device2holder" text="Washing Machine" />
                                        <Label fx:id="device2useage" text="0.0 kWh this week" />
                                        <Label id="weeklycost2" fx:id="weeklycost2" text="Weekly Cost: 0.00" />
                                    </VBox>

                                    <VBox id="device3" fx:id="device3" spacing="4.0">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                        </padding>
                                        <Label id="device3holder" fx:id="device3holder" text="Heating" />
                                        <Label fx:id="device3useage" text="0.0 kWh this week" />
                                        <Label id="weeklycost3" fx:id="weeklycost3" text="Weekly Cost: 0.00" />
                                    </VBox>
                                </VBox>

                                <Region prefHeight="6.0" />
                                <HBox fx:id="selection" alignment="CENTER" spacing="6.0">
                                    <Label fx:id="page1" style="-fx-padding: 4 10; -fx-font-weight: bold; -fx-font-size: 13;" styleClass="page-indicator" text="1">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Label>
                                    <Label fx:id="page2" style="-fx-padding: 4 10; -fx-font-size: 13;" styleClass="page-indicator" text="2">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Label>
                                    <Label fx:id="page3" style="-fx-padding: 4 10; -fx-font-size: 13;" styleClass="page-indicator" text="3">
                                        <cursor>
                                            <Cursor fx:constant="HAND" />
                                        </cursor>
                                    </Label>
                                </HBox>
                            </VBox>

                            <VBox spacing="16.0" GridPane.columnIndex="2">
                                <VBox id="energystatistics-auto-32" spacing="14.0" styleClass="energy-sources-card">
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                    </padding>

                                    <Label styleClass="energy-sources-title" text="Energy Sources" />

                                    <GridPane hgap="12.0" vgap="12.0">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50.0" />
                                            <ColumnConstraints percentWidth="50.0" />
                                        </columnConstraints>

                                        <VBox styleClass="source-tile">
                                            <Label styleClass="source-tile-title" text="Solar now" />
                                            <Label fx:id="solarNowValueLabel" styleClass="source-tile-value" text="0.0 kW" />
                                            <Label fx:id="solarNowDetailLabel" styleClass="source-tile-detail" text="0% of capacity" />
                                        </VBox>

                                        <VBox styleClass="source-tile" GridPane.columnIndex="1">
                                            <Label styleClass="source-tile-title" text="Battery charge" />
                                            <Label fx:id="batteryChargeValueLabel" styleClass="source-tile-value" text="0%" />
                                            <Label fx:id="batteryChargeDetailLabel" styleClass="source-tile-detail" text="0.0 / 0.0 kWh" />
                                        </VBox>
                                    </GridPane>

                                    <VBox spacing="8.0">
                                        <Label styleClass="source-note-label" text="Estimated source contribution" />
                                        <GridPane fx:id="sourceContributionBar" prefHeight="12.0" styleClass="source-contribution-bar">
                                            <columnConstraints>
                                                <ColumnConstraints fx:id="solarContributionColumn" percentWidth="0.0" />
                                                <ColumnConstraints fx:id="batteryContributionColumn" percentWidth="0.0" />
                                                <ColumnConstraints fx:id="gridContributionColumn" percentWidth="0.0" />
                                            </columnConstraints>
                                            <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="source-segment-solar" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" />
                                            <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="source-segment-battery" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" />
                                            <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="source-segment-grid" GridPane.columnIndex="2" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS" />
                                        </GridPane>
                                        <Label fx:id="sourceContributionSummaryLabel" styleClass="source-contribution-summary" text="0% solar &#8226; 0% battery &#8226; 0% grid" />
                                        <Label fx:id="sourceContributionEstimateLabel" styleClass="source-note-label" text="Estimated source contribution" wrapText="true" />
                                    </VBox>
                                </VBox>

                                <fx:include fx:id="solarStatusCard" source="SolarGenCard.fxml" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </GridPane>
                    </VBox>
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

    <AnchorPane id="graphOverlay" fx:id="graphOverlay" managed="false" visible="false">
        <BorderPane id="energystatistics-auto-36" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="24.0">
            <top>
                <HBox id="energystatistics-auto-37" alignment="CENTER_LEFT" spacing="12.0">
                    <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                    </padding>

                    <Button id="backButton" fx:id="backButton" text="Back" />

                    <Label id="energystatistics-auto-38" text="Usage" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label id="energystatistics-auto-39" text="Time Range" />
                    <ComboBox fx:id="timeRangeCombo" prefWidth="160.0" />
                </HBox>
            </top>

            <center>
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>

                    <Label id="energystatistics-auto-40" text="House Total Power Draw" />

                    <LineChart fx:id="usageChartLarge" animated="false" createSymbols="true" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis fx:id="usageLargeXAxis" autoRanging="false" label="Time" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="usageLargeYAxis" autoRanging="true" label="Power (kWh)" />
                        </yAxis>
                    </LineChart>
                </VBox>
            </center>
        </BorderPane>
    </AnchorPane>
</StackPane>
