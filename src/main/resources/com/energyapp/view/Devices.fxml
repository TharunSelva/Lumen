<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="devicesPlane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.energyapp.controller.DevicesController">
    <center>
        <VBox fx:id="devicesPaneMain" alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20;">
            <children>
                <Label fx:id="devicesTitle" text="Your Home Devices...">
                    <font>
                        <Font name="System Bold" size="40.0" />
                    </font>
                </Label>

                <ScrollPane fx:id="devicesScrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="deviceContainer" prefHeight="200.0" prefWidth="200.0" />
               </content>
                </ScrollPane>
            <Button fx:id="btnForAdd" mnemonicParsing="false" text="Add +" />
            </children>
        </VBox>
    </center>
</BorderPane>
